      "version": "2.0.0",
      "generator": "node design/build.mjs tokens (وكل بناء كامل يولّدها أولاً)",
      "generates": [
        "styles/tokens.css",
        "styles/status.css",
        "styles/tokens.native.json"
      ],
      "runtimeOverridable": [
        "brand-*",
        "primary",
        "primary-hover",
        "primary-active",
        "on-primary",
        "link",
        "focus-ring"
      ],
      "locked": [
        "status",
        "print",
        "police",
        "whatsapp",
        "on-*",
        "surface"
      ],
      "spec": "docs/15-visual-identity.md"
    }
  },
